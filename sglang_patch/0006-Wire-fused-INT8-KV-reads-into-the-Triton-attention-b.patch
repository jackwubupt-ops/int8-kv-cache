+        """Raw int8 K, int8 V, bf16 K scales, bf16 V scales of one layer, for fused kernels."""
+        i = layer_id - self.start_layer
+        return self.k_buffer[i], self.v_buffer[i], self.k_scale_buffer[i], self.v_scale_buffer[i]
+

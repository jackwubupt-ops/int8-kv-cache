+        # int8_per_token_head KV cache: fused kernels read int8 + scales directly.
+        int8_impl = getattr(model_runner.token_to_kv_pool, "int8_impl", None)
+        self.int8_kv_fused = int8_impl == "fused"
+        if int8_impl is not None:

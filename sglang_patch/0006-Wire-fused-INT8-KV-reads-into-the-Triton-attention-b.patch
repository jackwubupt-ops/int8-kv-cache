 class MHATokenToKVPoolINT8(MHATokenToKVPool):
     """MHA pool with int8 K/V and one bf16 scale per (token, head).
 
-    Reads dequantize the whole layer to compute_dtype, so any attention backend
-    sees a plain K/V buffer.
+    get_key_buffer / get_value_buffer dequantize the whole layer to compute_dtype,
+    so any reader sees a plain K/V buffer. With int8_impl == "fused" (read once from
+    SGLANG_INT8_KV_IMPL), writes use the Triton store kernel and the Triton backend
+    reads get_int8_kv_buffers instead, dequantizing inside its attention kernels.
     """
 
     def __init__(self, *args, compute_dtype: torch.dtype, **kwargs):
         if kwargs.get("enable_kv_cache_copy"):
             raise NotImplementedError("int8_per_token_head KV cache does not support KV copy")
         self.compute_dtype = compute_dtype
+        self.int8_impl = int8_kv_impl()
         super().__init__(*args, **kwargs)
 
     def _create_buffers(self):
@@ -1451,6 +1454,13 @@ class MHATokenToKVPoolINT8(MHATokenToKVPool):

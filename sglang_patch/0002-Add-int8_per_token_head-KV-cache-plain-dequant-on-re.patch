diff --git a/python/sglang/srt/layers/quantization/int8_kv.py b/python/sglang/srt/layers/quantization/int8_kv.py
index 2f3bdb3c..91dca0e6 100644
--- a/python/sglang/srt/layers/quantization/int8_kv.py
+++ b/python/sglang/srt/layers/quantization/int8_kv.py
@@ -21,6 +21,8 @@ This module only depends on torch so it can be tested without a GPU; the
 Triton store kernel must reproduce it exactly.
 """
 
+from typing import Optional
+
 import torch
 
 INT8_KV_QMAX = 127
@@ -53,3 +55,51 @@ def dequantize_per_token_head(
     """int8 [N, H, D] and scale [N, H] -> [N, H, D] in dtype."""
     out = q.to(torch.float32) * scale.to(torch.float32).unsqueeze(-1)
     return out.to(dtype)
+
+
+def store_quantized(
+    *, q_buf: torch.Tensor, scale_buf: torch.Tensor, loc: torch.Tensor, x: torch.Tensor
+) -> None:
+    """Quantize x [N, H, D] and write it into rows loc of q_buf [S, H, D] / scale_buf [S, H]."""
+    q, scale = quantize_per_token_head(x)
+    q_buf[loc] = q
+    scale_buf[loc] = scale
+
+
+def int8_kv_cell_size(
+    *, head_num: int, head_dim: int, v_head_dim: int, num_layers: int
+) -> int:
+    """KV bytes per token: int8 values plus one bf16 scale per head, for both K and V."""
+    return num_layers * head_num * (head_dim + v_head_dim + 2 * 2)
+
+
+def check_int8_kv_supported(
+    *,
+    attention_backend: Optional[str],
+    page_size: int,
+    tp_size: int,
+    use_mla: bool,
+    speculative_algorithm: Optional[str],
+    enable_hierarchical_cache: bool,
+    is_hybrid_swa: bool,
+) -> None:
+    """Fail fast on configurations the INT8 KV pool and kernels do not handle."""
+    problems = []
+    if attention_backend != "triton":
+        problems.append(f"attention backend {attention_backend!r} (pass --attention-backend triton)")
+    if page_size != 1:
+        problems.append(f"page_size={page_size}")
+    if tp_size != 1:
+        problems.append(f"tensor parallel size {tp_size}")
+    if use_mla:
+        problems.append("MLA models")
+    if speculative_algorithm is not None:
+        problems.append(f"speculative decoding ({speculative_algorithm})")
+    if enable_hierarchical_cache:
+        problems.append("hierarchical cache")
+    if is_hybrid_swa:
+        problems.append("hybrid sliding window attention")
+    if problems:
+        raise NotImplementedError(
+            "--kv-cache-dtype int8_per_token_head does not support: " + "; ".join(problems)
+        )

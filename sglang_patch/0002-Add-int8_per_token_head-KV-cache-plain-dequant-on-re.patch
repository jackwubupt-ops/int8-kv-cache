+class MHATokenToKVPoolINT8(MHATokenToKVPool):
+    """MHA pool with int8 K/V and one bf16 scale per (token, head).
+
+    Reads dequantize the whole layer to compute_dtype, so any attention backend
+    sees a plain K/V buffer.
+    """
+
+    def __init__(self, *args, compute_dtype: torch.dtype, **kwargs):
+        if kwargs.get("enable_kv_cache_copy"):
+            raise NotImplementedError("int8_per_token_head KV cache does not support KV copy")
+        self.compute_dtype = compute_dtype
+        super().__init__(*args, **kwargs)
+
+    def _create_buffers(self):
+        with self.memory_saver_adapter.region(GPU_MEMORY_TYPE_KV_CACHE):
+            with (
+                torch.cuda.use_mem_pool(self.custom_mem_pool)
+                if self.enable_custom_mem_pool
+                else nullcontext()
+            ):
+                # Slot 0 of the padded size receives dummy writes from padded tokens.
+                m = self.size + self.page_size
+                self.k_buffer = [
+                    torch.zeros((m, self.head_num, self.head_dim), dtype=torch.int8, device=self.device)
+                    for _ in range(self.layer_num)
+                ]
+                self.v_buffer = [
+                    torch.zeros((m, self.head_num, self.v_head_dim), dtype=torch.int8, device=self.device)
+                    for _ in range(self.layer_num)
+                ]
+                self.k_scale_buffer = [
+                    torch.zeros((m, self.head_num), dtype=torch.bfloat16, device=self.device)
+                    for _ in range(self.layer_num)
+                ]
+                self.v_scale_buffer = [
+                    torch.zeros((m, self.head_num), dtype=torch.bfloat16, device=self.device)
+                    for _ in range(self.layer_num)
+                ]
+
+    def _clear_buffers(self):
+        del self.k_buffer
+        del self.v_buffer
+        del self.k_scale_buffer
+        del self.v_scale_buffer
+
+    def get_kv_size_bytes(self):
+        k_size_bytes = sum(
+            get_tensor_size_bytes(t) for t in self.k_buffer + self.k_scale_buffer
+        )
+        v_size_bytes = sum(
+            get_tensor_size_bytes(t) for t in self.v_buffer + self.v_scale_buffer
+        )
+        return k_size_bytes, v_size_bytes
+
+    def get_kv_scale_buffer(self, layer_id: int) -> Tuple[torch.Tensor, torch.Tensor]:
+        """bf16 scales [size + page_size, head_num] for K and V of one layer."""
+        i = layer_id - self.start_layer
+        return self.k_scale_buffer[i], self.v_scale_buffer[i]
+
+    def _get_key_buffer(self, layer_id: int):
+        i = layer_id - self.start_layer
+        return dequantize_per_token_head(
+            self.k_buffer[i], self.k_scale_buffer[i], dtype=self.compute_dtype
+        )
+
+    def _get_value_buffer(self, layer_id: int):
+        i = layer_id - self.start_layer
+        return dequantize_per_token_head(
+            self.v_buffer[i], self.v_scale_buffer[i], dtype=self.compute_dtype
+        )
+
+    def set_kv_buffer(
+        self,
+        layer: RadixAttention,
+        loc: torch.Tensor,
+        cache_k: torch.Tensor,
+        cache_v: torch.Tensor,
+        k_scale: Optional[float] = None,
+        v_scale: Optional[float] = None,
+        layer_id_override: Optional[int] = None,
+    ):
+        if k_scale is not None or v_scale is not None:
+            raise ValueError(
+                "int8_per_token_head KV cache computes its own scales; "
+                "checkpoint k_scale/v_scale are not supported"
+            )
+        layer_id = layer_id_override if layer_id_override is not None else layer.layer_id
+        i = layer_id - self.start_layer
+        store_quantized(q_buf=self.k_buffer[i], scale_buf=self.k_scale_buffer[i], loc=loc, x=cache_k)
+        store_quantized(q_buf=self.v_buffer[i], scale_buf=self.v_scale_buffer[i], loc=loc, x=cache_v)
+
+    def get_contiguous_buf_infos(self):
+        raise NotImplementedError("int8_per_token_head KV cache does not support disaggregation")
+
+    def get_cpu_copy(self, indices, mamba_indices=None):
+        raise NotImplementedError("int8_per_token_head KV cache does not support CPU offload")
+
+    def load_cpu_copy(self, kv_cache_cpu, indices, mamba_indices=None):
+        raise NotImplementedError("int8_per_token_head KV cache does not support CPU offload")
+
+    def move_kv_cache(self, tgt_loc: torch.Tensor, src_loc: torch.Tensor):
+        raise NotImplementedError("int8_per_token_head KV cache does not support KV moves")
+
 class HybridLinearKVPool(KVCache):
     """KV cache with separate pools for full and linear attention layers."""
 

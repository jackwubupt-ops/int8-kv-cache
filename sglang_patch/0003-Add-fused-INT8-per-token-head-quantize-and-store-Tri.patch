+def int8_kv_impl() -> str:
+    """SGLANG_INT8_KV_IMPL: "fused" (default) uses the Triton kernels, "plain" this module's PyTorch code."""
+    impl = os.environ.get("SGLANG_INT8_KV_IMPL", "fused")
+    if impl not in INT8_KV_IMPLS:
+        raise ValueError(f"SGLANG_INT8_KV_IMPL must be one of {INT8_KV_IMPLS}, got {impl!r}")

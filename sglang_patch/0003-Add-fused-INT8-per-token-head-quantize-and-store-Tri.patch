+"""Fused per-token-head INT8 quantize-and-store for the KV cache.
+
+One program handles one (token, head) row and reproduces
+sglang.srt.layers.quantization.int8_kv.quantize_per_token_head exactly:
+scale = absmax / 127 (1 for an all-zero row), stored as bfloat16 rounded up,
+q = clamp(round_half_even(x / scale), -127, 127). Divisions use div_rn so they
+match PyTorch's IEEE FP32 division instead of Triton's approximate default.
+"""
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+
+@triton.jit
+def _int8_quantize_and_store_kernel(
+    cache_ptr,
+    loc_ptr,
+    q_ptr,
+    scale_ptr,
+    stride_cn,
+    stride_ch,
+    stride_qn,
+    stride_qh,
+    stride_sn,
+    stride_sh,
+    D: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    token = tl.program_id(0)
+    head = tl.program_id(1)
+    offs = tl.arange(0, BLOCK_D)
+    mask = offs < D
+
+    x = tl.load(cache_ptr + token * stride_cn + head * stride_ch + offs, mask=mask, other=0.0).to(tl.float32)
+    absmax = tl.max(tl.abs(x), axis=0)
+    scale = tl.where(absmax > 0, tl.math.div_rn(absmax, 127.0), 1.0)
+
+    # bfloat16 round-up: take the next bf16 value whenever round-to-nearest lands below.
+    scale_bf16 = scale.to(tl.bfloat16)
+    bumped = (scale_bf16.to(tl.int16, bitcast=True) + 1).to(tl.bfloat16, bitcast=True)
+    scale_bf16 = tl.where(scale_bf16.to(tl.float32) < scale, bumped, scale_bf16)
+
+    q = libdevice.rint(tl.math.div_rn(x, scale_bf16.to(tl.float32)))
+    q = tl.minimum(tl.maximum(q, -127.0), 127.0).to(tl.int8)
+
+    slot = tl.load(loc_ptr + token).to(tl.int64)
+    tl.store(q_ptr + slot * stride_qn + head * stride_qh + offs, q, mask=mask)
+    tl.store(scale_ptr + slot * stride_sn + head * stride_sh, scale_bf16)
+
+
+def int8_quantize_and_store(
+    cache: torch.Tensor, loc: torch.Tensor, q_buf: torch.Tensor, scale_buf: torch.Tensor
+) -> None:
+    """Quantize cache [N, H, D] (bf16/fp16) into rows loc [N] of q_buf [S, H, D] int8 and scale_buf [S, H] bf16."""
+    n, h, d = cache.shape
+    if n == 0:
+        return
+    if cache.stride(-1) != 1 or q_buf.stride(-1) != 1:
+        raise ValueError("int8_quantize_and_store needs a unit stride along head_dim")
+    if q_buf.dtype != torch.int8 or scale_buf.dtype != torch.bfloat16:
+        raise ValueError(f"expected int8 values and bfloat16 scales, got {q_buf.dtype} and {scale_buf.dtype}")
+    _int8_quantize_and_store_kernel[(n, h)](
+        cache,
+        loc,
+        q_buf,
+        scale_buf,
+        cache.stride(0),
+        cache.stride(1),
+        q_buf.stride(0),
+        q_buf.stride(1),
+        scale_buf.stride(0),
+        scale_buf.stride(1),
+        D=d,
+        BLOCK_D=triton.next_power_of_2(d),
+    )
